#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * apidoc command line entry point.
 *
 * Works both from the package itself and when installed as a dependency, where
 * the autoloader lives three levels up.
 */

use Kontirol\ApiDoc\Cli\Console;

$candidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloader = null;

foreach ($candidates as $candidate) {
    if (is_file($candidate)) {
        $autoloader = $candidate;

        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, 'apidoc: unable to find the composer autoloader.' . PHP_EOL);

    exit(1);
}

require $autoloader;

/** @var list<string> $argv */
exit((new Console())->run($argv));
